# Git Mirror Configuration
# Uncomment and fill in the required values below
# Supports AWS CodeCommit and GitHub providers.

# --- AWS CodeCommit ---

# OPTIONAL: Comma-separated list of AWS Account IDs to mirror repositories from
# If not set, only GitHub provider will be active (if configured).
# Example: 123456789012,210987654321
# AWS_ACCOUNT_IDS=123456789012

# OPTIONAL: Path to SSH private key for CodeCommit authentication
# Only required when using AWS CodeCommit with SSH URLs.
# Supports ~ expansion for home directory.
# Example: ~/.ssh/id_rsa or /path/to/.ssh/id_rsa
# SSH_KEY_PATH=/path/to/.ssh/id_rsa

# REQUIRED: Local directory where cloned repositories will be stored
# Output structure: provider/account_or_org/[region/]repository_name
# Example: ./mirror or /home/user/git-mirror
# MIRROR_OUTPUT_DIR=./mirror

# OPTIONAL: AWS default region for initial API calls
# Defaults to us-east-1 if not specified
# Used to initialize AWS SDK and discover other regions
# AWS_DEFAULT_REGION=us-east-1

# OPTIONAL: Comma-separated list of AWS regions to mirror from
# If not specified, all available regions will be discovered and mirrored
# Example: us-east-1,us-west-2,eu-west-1
# AWS_REGIONS=us-east-1,us-west-2

# OPTIONAL: AWS credentials profile name (if using ~/.aws/credentials)
# Defaults to "default" if not specified
# AWS_CREDENTIALS_PROFILE=default

# OPTIONAL: Map specific AWS profiles to account IDs for cross-account access
# Format: ACCOUNT_ID:PROFILE_NAME,ACCOUNT_ID:PROFILE_NAME
# Example: 123456789012:production,210987654321:development
# If not set, uses AWS_CREDENTIALS_PROFILE for all accounts
# AWS_ACCOUNT_PROFILES=123456789012:production

# OPTIONAL: Number of concurrent clone operations
# Defaults to 5 if not specified
# Higher values = faster cloning but more system load
# CONCURRENT_CLONES=5

# OPTIONAL: Logging level (debug, info, warn, error)
# Defaults to "info" if not specified
# LOG_LEVEL=info

# OPTIONAL: Path to git executable
# If not specified, defaults to "git" (assumes git is in PATH)
# Useful if you have multiple git installations or a non-standard installation path
# Example: /usr/bin/git or /usr/local/bin/git
# GIT_PATH=git

# OPTIONAL: Git path format - how to pass paths to git command
# Values: "linux" or "windows"
# Defaults to "linux" if not specified
# Set to "windows" if using Windows Git (e.g., wgit) from WSL
# - "linux": paths like /mnt/c/path (default for WSL git)
# - "windows": paths converted to C:\path format (for Windows git like wgit)
# Useful when running Windows git binary from WSL
# GIT_PATH_FORMAT=linux

# OPTIONAL: Enable logging of all executed commands
# Defaults to false if not specified
# Set to true to see every git, AWS CLI, and gh CLI command being executed
# Useful for debugging
# LOG_COMMANDS=false

# --- GitHub ---
# GitHub provider is automatically activated when GITHUB_ORGS is set.
# Requires GitHub CLI (gh) to be installed and authenticated, or set GITHUB_TOKEN.

# OPTIONAL: Comma-separated list of GitHub organizations to mirror
# Activates the GitHub provider automatically
# Example: my-org,another-org
# GITHUB_ORGS=my-org

# OPTIONAL: GitHub personal access token for authentication
# Only needed if gh CLI is not already authenticated (e.g., gh auth login)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx
